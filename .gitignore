# --- Omnigraph generated state (never commit) --------------------------------
# The actual graph data — Lance datasets created by `make init` / `make seed`.
# This is a database, not source. Rebuild anytime with `make init && make seed`.
graphs/
*.omni/

# Cluster control-plane local state: the state ledger, catalog, and approvals.
# Terraform-style local state — regenerated by `omnigraph cluster import/apply`.
__cluster/

# Legacy combined config (RFC-008). Source of truth is cluster.yaml +
# omnigraph-config.example.yaml; per-operator config lives at ~/.omnigraph/config.yaml.
omnigraph.yaml

# --- Secrets / environment ---------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example

# --- Local scratch -----------------------------------------------------------
*.log
*.skill                 # packaged skill bundles (npx skills package)

# --- Tooling / OS noise ------------------------------------------------------
.claude/
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# NOTE: these ARE committed (source you author) — schema.pg, queries/,
